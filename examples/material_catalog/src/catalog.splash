// Material-Design-3 component catalog, authored in the Splash DSL and rendered
// as makepad native widgets. Colours follow the M3 baseline light scheme.

fn argb(a, r, g, b) { return ((a * 256 + r) * 256 + g) * 256 + b }
// Pick dark (a) or light (b) by the injected st.dark flag.
fn pick(d, a, b) { if d == 1 { return a } return b }
let dk = st.dark

// M3 baseline palette — dark / light selected by st.dark.
let primary       = pick(dk, argb(255, 208, 188, 255), argb(255, 103,  80, 164))
let on_primary    = pick(dk, argb(255,  56,  30, 114), argb(255, 255, 255, 255))
let pri_container = pick(dk, argb(255,  79,  55, 139), argb(255, 234, 221, 255))
let on_pri_cont   = pick(dk, argb(255, 234, 221, 255), argb(255,  33,   0,  93))
let secondary     = pick(dk, argb(255, 204, 194, 220), argb(255,  98,  91, 113))
let sec_container = pick(dk, argb(255,  74,  68,  88), argb(255, 232, 222, 248))
let on_sec_cont   = pick(dk, argb(255, 232, 222, 248), argb(255,  29,  25,  43))
let tertiary      = pick(dk, argb(255, 239, 184, 200), argb(255, 125,  82,  96))
let ter_container = pick(dk, argb(255,  99,  59,  72), argb(255, 255, 216, 228))
let surface       = pick(dk, argb(255,  20,  18,  24), argb(255, 254, 247, 255))
let surf_variant  = pick(dk, argb(255,  73,  69,  79), argb(255, 231, 224, 236))
let surf_cont     = pick(dk, argb(255,  33,  31,  38), argb(255, 243, 237, 247))
let on_surface    = pick(dk, argb(255, 230, 224, 233), argb(255,  29,  27,  32))
let on_surf_var   = pick(dk, argb(255, 202, 196, 208), argb(255,  73,  69,  79))
let outline       = pick(dk, argb(255, 147, 143, 153), argb(255, 121, 116, 126))
let outline_var   = pick(dk, argb(255,  73,  69,  79), argb(255, 202, 196, 208))
let error         = pick(dk, argb(255, 242, 184, 181), argb(255, 179,  38,  30))
let white         = pick(dk, argb(255,  33,  31,  38), argb(255, 255, 255, 255))   // card surface
let page          = pick(dk, argb(255,  20,  18,  24), argb(255, 254, 247, 255))   // page background

// ---- component helpers -----------------------------------------------------

// A titled white card grouping one component family.
fn section(title, kids) {
    let c = [ {t: "text", text: title, size: 16, color: on_surface, h: 24} ]
    for k in kids { c.push(k) }
    return {t: "column", bg: white, radius: 16, pad: 16, spacing: 12, c: c}
}

// A pill button that hugs its label (fitw) with the label centred.
fn btn(txt, fill, ink) {
    return {t: "column", bg: fill, radius: 20, pad: 12, fitw: 1,
            alignx: 0.5, aligny: 0.5,
            c: [ {t: "text", text: txt, size: 14, color: ink} ]}
}
fn outlined_btn(txt) {
    return {t: "column", bg: surface, border: 1, bordercolor: outline_var,
            radius: 20, pad: 12, fitw: 1, alignx: 0.5, aligny: 0.5,
            c: [ {t: "text", text: txt, size: 14, color: primary} ]}
}
fn text_btn(txt) {
    return {t: "column", radius: 20, pad: 12, fitw: 1, alignx: 0.5, aligny: 0.5,
            c: [ {t: "text", text: txt, size: 14, color: primary} ]}
}

// A chip: filled (selected) or outlined (assist/suggestion).
fn chip(txt) {
    return {t: "column", bg: surface, border: 1, bordercolor: outline_var,
            radius: 8, pad: 8, fitw: 1, alignx: 0.5, aligny: 0.5,
            c: [ {t: "text", text: txt, size: 13, color: on_surf_var} ]}
}
fn chip_sel(txt) {
    return {t: "column", bg: sec_container, radius: 8, pad: 8, fitw: 1,
            alignx: 0.5, aligny: 0.5,
            c: [ {t: "text", text: txt, size: 13, color: on_sec_cont} ]}
}

// A card tile with a title + supporting text.
fn tile(title, supporting, bg, bord) {
    return {t: "column", bg: bg, border: bord, bordercolor: outline_var,
            radius: 12, pad: 16, spacing: 6, fitw: 1, w: 150,
            c: [
                {t: "text", text: title, size: 15, color: on_surface, h: 22},
                {t: "text", text: supporting, size: 13, color: on_surf_var, h: 36},
            ]}
}

// A linear progress track with a proportional fill.
fn progress(fill_w) {
    return {t: "column", bg: surf_variant, radius: 2, h: 4,
            c: [ {t: "column", bg: primary, radius: 2, h: 4, w: fill_w} ]}
}

// A list row: leading avatar + title/subtitle.
fn list_item(letter, title, subtitle) {
    return {t: "row", h: 60, spacing: 16, aligny: 0.5, c: [
        {t: "column", bg: pri_container, radius: 20, w: 40, h: 40,
         alignx: 0.5, aligny: 0.5,
         c: [ {t: "text", text: letter, size: 16, color: on_pri_cont} ]},
        {t: "column", spacing: 2, c: [
            {t: "text", text: title, size: 16, color: on_surface, h: 22},
            {t: "text", text: subtitle, size: 13, color: on_surf_var, h: 18},
        ]},
    ]}
}

fn divider() { return {t: "column", bg: outline_var, h: 1} }

// A bottom-navigation destination.
fn nav_item(icon, label, ink, pill) {
    return {t: "column", fitw: 1, spacing: 4, alignx: 0.5, c: [
        {t: "column", bg: pill, radius: 16, w: 56, h: 32, alignx: 0.5, aligny: 0.5,
         c: [ {t: "text", text: icon, size: 16, color: ink} ]},
        {t: "text", text: label, size: 12, color: ink, h: 16},
    ]}
}

// A colour-role swatch.
fn swatch(c, name) {
    return {t: "column", fitw: 1, spacing: 4, c: [
        {t: "column", bg: c, radius: 8, w: 66, h: 48},
        {t: "text", text: name, size: 11, color: on_surf_var, h: 14},
    ]}
}

// A top app bar: leading icon, title, spacer, trailing action icons.
fn appbar(title) {
    return {t: "row", bg: surf_cont, h: 60, pad: 14, spacing: 16, aligny: 0.5, c: [
        {t: "text", text: "\u{2261}", size: 22, color: on_surface, fitw: 1},
        {t: "text", text: title, size: 20, color: on_surface, fitw: 1},
        {t: "column", c: []},
        {t: "text", text: "\u{1F50D}", size: 20, color: on_surface, fitw: 1},
        {t: "text", text: "\u{22EE}", size: 20, color: on_surface, fitw: 1},
    ]}
}

// A tab: active shows the primary underline indicator.
fn tab_active(txt) {
    return {t: "column", fitw: 1, spacing: 8, alignx: 0.5, c: [
        {t: "text", text: txt, size: 14, color: primary, h: 20},
        {t: "column", bg: primary, radius: 2, h: 3, w: 44},
    ]}
}
fn tab_idle(txt) {
    return {t: "column", fitw: 1, spacing: 8, alignx: 0.5, c: [
        {t: "text", text: txt, size: 14, color: on_surf_var, h: 20},
        {t: "column", bg: white, radius: 2, h: 3, w: 44},
    ]}
}

// One segment of a segmented button.
fn seg_on(txt) {
    return {t: "column", bg: sec_container, border: 1, bordercolor: outline,
            h: 40, pad: 14, fitw: 1, alignx: 0.5, aligny: 0.5,
            c: [ {t: "text", text: "\u{2713} " + txt, size: 13, color: on_sec_cont} ]}
}
fn seg_off(txt) {
    return {t: "column", bg: surface, border: 1, bordercolor: outline,
            h: 40, pad: 14, fitw: 1, alignx: 0.5, aligny: 0.5,
            c: [ {t: "text", text: txt, size: 13, color: on_surf_var} ]}
}

// A search bar (pill).
fn searchbar() {
    return {t: "row", bg: surf_variant, radius: 28, h: 56, pad: 18, spacing: 14, aligny: 0.5, c: [
        {t: "text", text: "\u{1F50D}", size: 20, color: on_surf_var, fitw: 1},
        {t: "text", text: "Search the catalog", size: 16, color: on_surf_var, fitw: 1},
    ]}
}

// An icon carrying a small count badge.
fn badge(icon, count) {
    return {t: "row", fitw: 1, spacing: 4, c: [
        {t: "text", text: icon, size: 26, color: on_surface, fitw: 1},
        {t: "column", bg: error, radius: 9, w: 18, h: 18, alignx: 0.5, aligny: 0.5,
         c: [ {t: "text", text: count, size: 10, color: white} ]},
    ]}
}

// A modal dialog (mock). The body Label is given a width so makepad wraps it.
fn dialog() {
    return {t: "column", bg: surface, border: 1, bordercolor: outline_var,
            radius: 28, pad: 24, spacing: 16, c: [
        {t: "text", text: "Reset settings?", size: 22, color: on_surface, h: 30},
        {t: "text", text: "This will restore default values for every preference in this app.",
         size: 14, color: on_surf_var, w: 280, h: 44},
        {t: "row", spacing: 8, aligny: 0.5, c: [
            {t: "column", c: []},
            text_btn("Cancel"),
            text_btn("Reset"),
        ]},
    ]}
}

// A bottom sheet: drag handle + a few actions.
fn sheet_row(icon, txt) {
    return {t: "row", h: 48, spacing: 16, aligny: 0.5, c: [
        {t: "text", text: icon, size: 20, color: on_surf_var, fitw: 1},
        {t: "text", text: txt, size: 16, color: on_surface, fitw: 1},
    ]}
}
fn bottom_sheet() {
    return {t: "column", bg: surf_cont, radius: 28, pad: 16, spacing: 4, alignx: 0.5, c: [
        {t: "column", bg: outline_var, radius: 2, w: 32, h: 4},
        sheet_row("\u{2606}", "Add to favourites"),
        sheet_row("\u{2709}", "Share via email"),
        sheet_row("\u{2699}", "Edit label"),
    ]}
}

// A date picker (mini month grid). 7 equal columns per row.
fn dhead(t) { return {t: "column", alignx: 0.5, c: [ {t: "text", text: t, size: 12, color: on_surf_var, h: 28} ]} }
fn dday(t)  { return {t: "column", alignx: 0.5, aligny: 0.5, h: 38, c: [ {t: "text", text: t, size: 14, color: on_surface} ]} }
fn dsel(t)  { return {t: "column", alignx: 0.5, aligny: 0.5, h: 38, c: [
                  {t: "column", bg: primary, radius: 16, w: 32, h: 32, alignx: 0.5, aligny: 0.5,
                   c: [ {t: "text", text: t, size: 14, color: on_primary} ]} ]} }
fn date_picker() {
    return {t: "column", bg: surface, border: 1, bordercolor: outline_var, radius: 16, pad: 16, spacing: 8, c: [
        {t: "row", aligny: 0.5, c: [
            {t: "text", text: "March 2026", size: 16, color: on_surface, fitw: 1},
            {t: "column", c: []},
            {t: "text", text: "\u{2039}   \u{203A}", size: 18, color: on_surf_var, fitw: 1},
        ]},
        {t: "row", c: [ dhead("S"), dhead("M"), dhead("T"), dhead("W"), dhead("T"), dhead("F"), dhead("S") ]},
        {t: "row", c: [ dday("2"), dday("3"), dday("4"), dday("5"), dday("6"), dday("7"), dday("8") ]},
        {t: "row", c: [ dday("9"), dday("10"), dsel("11"), dday("12"), dday("13"), dday("14"), dday("15") ]},
        {t: "row", c: [ dday("16"), dday("17"), dday("18"), dday("19"), dday("20"), dday("21"), dday("22") ]},
    ]}
}

// A time picker (mock): large HH:MM with AM/PM.
fn time_picker() {
    return {t: "row", spacing: 12, aligny: 0.5, c: [
        {t: "column", bg: pri_container, radius: 8, w: 84, h: 72, alignx: 0.5, aligny: 0.5,
         c: [ {t: "text", text: "10", size: 44, color: on_pri_cont} ]},
        {t: "text", text: ":", size: 44, color: on_surface, fitw: 1},
        {t: "column", bg: surf_variant, radius: 8, w: 84, h: 72, alignx: 0.5, aligny: 0.5,
         c: [ {t: "text", text: "30", size: 44, color: on_surface} ]},
        {t: "column", spacing: 0, c: [
            {t: "column", bg: sec_container, border: 1, bordercolor: outline, radius: 8, w: 48, h: 36, alignx: 0.5, aligny: 0.5,
             c: [ {t: "text", text: "AM", size: 14, color: on_sec_cont} ]},
            {t: "column", bg: surface, border: 1, bordercolor: outline, radius: 8, w: 48, h: 36, alignx: 0.5, aligny: 0.5,
             c: [ {t: "text", text: "PM", size: 14, color: on_surf_var} ]},
        ]},
    ]}
}

// A tooltip bubble.
fn tooltip() {
    return {t: "column", bg: argb(255, 50, 47, 55), radius: 6, pad: 8, fitw: 1, alignx: 0.5, aligny: 0.5,
            c: [ {t: "text", text: "Tooltip label", size: 12, color: argb(255, 244, 239, 244)} ]}
}

// A circular progress indicator (mock): a primary ring.
fn ring() {
    return {t: "column", bg: surface, border: 4, bordercolor: primary, radius: 22, w: 44, h: 44}
}

// A snackbar (inverse surface) with an action.
fn snackbar() {
    return {t: "row", bg: argb(255, 50, 47, 55), radius: 8, h: 50, pad: 16, spacing: 16, aligny: 0.5, c: [
        {t: "text", text: "Photo added to album", size: 14, color: argb(255, 244, 239, 244), fitw: 1},
        {t: "column", c: []},
        {t: "text", text: "UNDO", size: 14, color: argb(255, 208, 188, 255), fitw: 1},
    ]}
}

// A dropdown menu (mock).
fn menu_item(txt) {
    return {t: "row", h: 44, pad: 12, aligny: 0.5, c: [
        {t: "text", text: txt, size: 15, color: on_surface} ]}
}
fn menu() {
    return {t: "column", bg: surface, border: 1, bordercolor: outline_var,
            radius: 8, pad: 8, w: 220, fitw: 1, c: [
        menu_item("Edit"), menu_item("Duplicate"), menu_item("Share"), menu_item("Delete"),
    ]}
}

// A bottom app bar: action icons on the left, a FAB on the right.
fn bottom_app_bar() {
    return {t: "row", bg: surf_cont, h: 64, pad: 14, spacing: 22, aligny: 0.5, c: [
        {t: "text", text: "\u{2261}", size: 22, color: on_surf_var, fitw: 1},
        {t: "text", text: "\u{2605}", size: 20, color: on_surf_var, fitw: 1},
        {t: "text", text: "\u{2709}", size: 20, color: on_surf_var, fitw: 1},
        {t: "column", c: []},
        {t: "column", bg: pri_container, radius: 16, w: 56, h: 56, alignx: 0.5, aligny: 0.5,
         c: [ {t: "text", text: "\u{FF0B}", size: 24, color: on_pri_cont} ]},
    ]}
}

// A navigation rail destination + the rail itself.
fn rail_item(icon, label, ink, pill) {
    return {t: "column", spacing: 4, alignx: 0.5, c: [
        {t: "column", bg: pill, radius: 16, w: 56, h: 32, alignx: 0.5, aligny: 0.5,
         c: [ {t: "text", text: icon, size: 16, color: ink} ]},
        {t: "text", text: label, size: 12, color: ink, h: 16},
    ]}
}
fn nav_rail() {
    return {t: "column", bg: surf_cont, radius: 16, pad: 12, spacing: 16, w: 96, alignx: 0.5, c: [
        {t: "column", bg: pri_container, radius: 16, w: 56, h: 56, alignx: 0.5, aligny: 0.5,
         c: [ {t: "text", text: "\u{FF0B}", size: 24, color: on_pri_cont} ]},
        rail_item("\u{2302}", "Home", on_sec_cont, sec_container),
        rail_item("\u{2605}", "Saved", on_surf_var, surf_cont),
        rail_item("\u{2709}", "Inbox", on_surf_var, surf_cont),
    ]}
}

// A carousel of media items (fixed widths; the row edge clips like a scrollable
// carousel).
fn carousel() {
    return {t: "row", spacing: 8, c: [
        {t: "column", bg: pri_container, radius: 16, w: 110, h: 120},
        {t: "column", bg: sec_container, radius: 16, w: 140, h: 120},
        {t: "column", bg: ter_container, radius: 16, w: 80, h: 120},
    ]}
}

// A banner: leading icon, message, trailing actions.
fn banner() {
    return {t: "column", bg: surf_cont, radius: 12, pad: 16, spacing: 12, c: [
        {t: "row", spacing: 12, c: [
            {t: "text", text: "\u{2757}", size: 20, color: primary, fitw: 1},
            {t: "text", text: "Your storage is almost full \u{2014} upgrade to keep syncing.",
             size: 14, color: on_surface, w: 250, h: 40},
        ]},
        {t: "row", spacing: 8, aligny: 0.5, c: [
            {t: "column", c: []}, text_btn("Dismiss"), text_btn("Upgrade"),
        ]},
    ]}
}

// ---- catalog ---------------------------------------------------------------

// ---- navigation ------------------------------------------------------------

// A full-width nav row (Button) that routes to a demo screen on tap.
fn nav_btn(label, route) {
    return {t: "button", label: label, tapto: route, fillw: 1, h: 52}
}
// A back button that routes to the home screen.
fn back_btn() {
    return {t: "button", label: "\u{2039}  Back", tapto: "home", fitw: 1, h: 40}
}
// A demo screen shell: back button + big title + the family's sections.
fn demo(title, kids) {
    let c = [ back_btn(), {t: "text", text: title, size: 28, color: on_surface, h: 42} ]
    for k in kids { c.push(k) }
    return {t: "column", spacing: 16, c: c}
}

// ---- interactive (stateful) helpers ----------------------------------------
// Read injected state (st.tab/st.seg/st.date/snack) and emit Button taps the
// host turns into a state change + re-mount, so these demos actually respond.

fn itab(label, val) {
    if val == st.tab { return {t: "button", label: "\u{25CF} " + label, tapto: "tab:" + val, fillw: 1, h: 44} }
    return {t: "button", label: label, tapto: "tab:" + val, fillw: 1, h: 44}
}
fn tab_body() {
    if st.tab == "specs" { return {t: "text", text: "Specs \u{00b7} 6.5\" OLED \u{00b7} 128 GB \u{00b7} 5000 mAh", size: 15, color: on_surf_var, w: 330, h: 24} }
    if st.tab == "related" { return {t: "text", text: "Related \u{00b7} cases \u{00b7} chargers \u{00b7} covers", size: 15, color: on_surf_var, w: 330, h: 24} }
    return {t: "text", text: "Overview \u{00b7} the active tab's content shows here", size: 15, color: on_surf_var, w: 330, h: 24}
}

fn iseg(label, val) {
    if val == st.seg { return {t: "button", label: "\u{2713} " + label, tapto: "seg:" + val, fillw: 1, h: 44} }
    return {t: "button", label: label, tapto: "seg:" + val, fillw: 1, h: 44}
}

fn isnackbar() {
    if st.snack == 1 { return {t: "row", bg: argb(255, 50, 47, 55), radius: 8, h: 50, pad: 16, aligny: 0.5, c: [
        {t: "text", text: "\u{2713}  Photo added to album", size: 14, color: argb(255, 244, 239, 244), fitw: 1},
    ]} }
    return {t: "text", text: "(hidden \u{2014} tap Show)", size: 13, color: on_surf_var, h: 20}
}

fn iday(d) {
    if d == st.date { return {t: "button", label: "\u{25CF}" + d, tapto: "date:" + d, fillw: 1, h: 40} }
    return {t: "button", label: d, tapto: "date:" + d, fillw: 1, h: 40}
}
fn idate_picker() {
    return {t: "column", bg: surface, border: 1, bordercolor: outline_var, radius: 16, pad: 16, spacing: 8, c: [
        {t: "text", text: "March 2026 \u{00b7} tap a day", size: 16, color: on_surface, h: 24},
        {t: "row", c: [ dhead("S"), dhead("M"), dhead("T"), dhead("W"), dhead("T"), dhead("F"), dhead("S") ]},
        {t: "row", spacing: 2, c: [ iday("2"), iday("3"), iday("4"), iday("5"), iday("6"), iday("7"), iday("8") ]},
        {t: "row", spacing: 2, c: [ iday("9"), iday("10"), iday("11"), iday("12"), iday("13"), iday("14"), iday("15") ]},
        {t: "row", spacing: 2, c: [ iday("16"), iday("17"), iday("18"), iday("19"), iday("20"), iday("21"), iday("22") ]},
    ]}
}

// ---- screens ---------------------------------------------------------------

fn home_screen() {
    return {t: "column", spacing: 8, c: [
        {t: "text", text: "Material Catalog", size: 30, color: on_surface, h: 42},
        {t: "text", text: "Splash \u{2192} makepad native \u{00b7} tap a family", size: 14, color: on_surf_var, h: 22},
        {t: "column", h: 6},
        // Live app state: the buttons drive Rust-side state, re-mounted.
        {t: "column", bg: white, radius: 16, pad: 16, spacing: 10, c: [
            {t: "text", text: "Live state \u{00b7} tapped " + st.count + " times", size: 15, color: on_surface, h: 22},
            {t: "row", spacing: 8, c: [
                {t: "button", label: "Tap me (+1)", tapto: "act:count", fillw: 1, h: 48},
                {t: "button", label: "Toggle theme", tapto: "theme:toggle", fillw: 1, h: 48},
            ]},
        ]},
        {t: "column", h: 6},
        nav_btn("Buttons", "buttons"),
        nav_btn("Selection controls", "selection"),
        nav_btn("Text fields & sliders", "text"),
        nav_btn("Chips", "chips"),
        nav_btn("Cards & lists", "cards"),
        nav_btn("Navigation", "nav"),
        nav_btn("Dialogs & communication", "comms"),
        nav_btn("Date & time pickers", "pickers"),
        nav_btn("Progress", "progress"),
        nav_btn("Typography & color", "type"),
    ]}
}

fn demo_buttons() {
    return demo("Buttons", [
        section("Common buttons", [
            {t: "row", spacing: 8, c: [
                btn("Filled", primary, on_primary),
                btn("Tonal", sec_container, on_sec_cont),
                btn("Elevated", surf_cont, primary),
            ]},
            {t: "row", spacing: 8, c: [ outlined_btn("Outlined"), text_btn("Text") ]},
        ]),
        section("Segmented buttons (tap to select)", [
            {t: "row", spacing: 4, c: [ iseg("Day", "day"), iseg("Week", "week"), iseg("Month", "month") ]},
            {t: "text", text: "Showing: " + st.seg, size: 13, color: on_surf_var, h: 18},
        ]),
        section("Floating action buttons", [
            {t: "row", spacing: 16, aligny: 0.5, c: [
                {t: "column", bg: pri_container, radius: 12, w: 40, h: 40, alignx: 0.5, aligny: 0.5,
                 c: [ {t: "text", text: "\u{FF0B}", size: 18, color: on_pri_cont} ]},
                {t: "column", bg: pri_container, radius: 16, w: 56, h: 56, alignx: 0.5, aligny: 0.5,
                 c: [ {t: "text", text: "\u{FF0B}", size: 24, color: on_pri_cont} ]},
                {t: "row", bg: pri_container, radius: 16, h: 56, pad: 18, fitw: 1, spacing: 10, aligny: 0.5,
                 c: [ {t: "text", text: "\u{FF0B}", size: 20, color: on_pri_cont},
                      {t: "text", text: "Extended", size: 15, color: on_pri_cont} ]},
            ]},
        ]),
    ])
}

fn demo_selection() {
    return demo("Selection controls", [
        section("Checkbox, switch, radio", [
            {t: "checkbox", text: "Checkbox", color: on_surface, h: 34},
            {t: "toggle", text: "Switch", color: on_surface, h: 34},
            {t: "radio", text: "Radio option A", color: on_surface, h: 34},
            {t: "radio", text: "Radio option B", color: on_surface, h: 34},
        ]),
    ])
}

fn demo_text() {
    return demo("Text fields & sliders", [
        section("Text fields", [
            {t: "input", placeholder: "Filled text field", h: 50},
            {t: "input", placeholder: "Another field", h: 50},
        ]),
        section("Search", [ searchbar() ]),
        section("Sliders", [ {t: "slider", text: "Continuous", color: on_surface, h: 44} ]),
    ])
}

fn demo_chips() {
    return demo("Chips", [
        section("Chips", [
            {t: "row", spacing: 8, c: [ chip("Assist"), chip("Filter"), chip_sel("Selected") ]},
            {t: "row", spacing: 8, c: [ chip("Suggestion"), chip("Input \u{00d7}") ]},
        ]),
    ])
}

fn demo_cards() {
    return demo("Cards & lists", [
        section("Cards", [
            {t: "row", spacing: 12, c: [
                tile("Elevated", "Filled surface tone", surf_cont, 0),
                tile("Outlined", "1dp outline variant", surface, 1),
            ]},
        ]),
        section("Lists", [
            list_item("A", "Ada Lovelace", "Analytical engine"),
            divider(),
            list_item("G", "Grace Hopper", "Compiler pioneer"),
        ]),
        section("Carousel", [ carousel() ]),
    ])
}

fn demo_nav() {
    return demo("Navigation", [
        section("Top app bar", [ appbar("Catalog") ]),
        section("Bottom app bar", [ bottom_app_bar() ]),
        section("Navigation bar", [
            {t: "row", bg: surf_cont, radius: 16, pad: 8, h: 72, c: [
                nav_item("\u{2302}", "Home", on_sec_cont, sec_container),
                nav_item("\u{2605}", "Saved", on_surf_var, surf_cont),
                nav_item("\u{2709}", "Inbox", on_surf_var, surf_cont),
                nav_item("\u{263A}", "Profile", on_surf_var, surf_cont),
            ]},
        ]),
        section("Navigation rail", [ {t: "row", c: [ nav_rail() ]} ]),
        section("Tabs (tap to switch)", [
            {t: "row", spacing: 4, c: [ itab("Overview", "overview"), itab("Specs", "specs"), itab("Related", "related") ]},
            {t: "column", bg: outline_var, h: 1},
            tab_body(),
        ]),
    ])
}

fn demo_comms() {
    return demo("Dialogs & communication", [
        section("Dialog", [ dialog() ]),
        section("Snackbar (show / hide)", [
            {t: "row", spacing: 8, c: [
                {t: "button", label: "Show", tapto: "snack:show", fillw: 1, h: 48},
                {t: "button", label: "Hide", tapto: "snack:hide", fillw: 1, h: 48},
            ]},
            isnackbar(),
        ]),
        section("Menu", [ menu() ]),
        section("Bottom sheet", [ bottom_sheet() ]),
        section("Tooltip", [ {t: "row", c: [ tooltip() ]} ]),
        section("Banner", [ banner() ]),
        section("Badges", [
            {t: "row", spacing: 32, aligny: 0.5, c: [
                badge("\u{2709}", "3"), badge("\u{2302}", "12"), badge("\u{2605}", "99+"),
            ]},
        ]),
    ])
}

fn demo_pickers() {
    return demo("Date & time pickers", [
        section("Date picker (tap a day)", [ idate_picker() ]),
        section("Time picker", [ time_picker() ]),
    ])
}

fn demo_progress() {
    return demo("Progress", [
        section("Linear", [
            {t: "text", text: "40%", size: 13, color: on_surf_var, h: 18},
            progress(150),
            {t: "text", text: "75%", size: 13, color: on_surf_var, h: 18},
            progress(280),
        ]),
        section("Circular", [
            {t: "row", spacing: 20, aligny: 0.5, c: [ ring(), ring(), ring() ]},
        ]),
    ])
}

fn demo_type() {
    return demo("Typography & color", [
        section("Typography", [
            {t: "text", text: "Display Small", size: 34, color: on_surface, h: 44},
            {t: "text", text: "Headline Small", size: 24, color: on_surface, h: 32},
            {t: "text", text: "Title Large", size: 21, color: on_surface, h: 28},
            {t: "text", text: "Body Large \u{2014} the quick brown fox", size: 16, color: on_surf_var, h: 22},
            {t: "text", text: "LABEL LARGE", size: 13, color: on_surf_var, h: 18},
        ]),
        section("Color roles", [
            {t: "row", spacing: 10, c: [
                swatch(primary, "Primary"), swatch(secondary, "Secondary"),
                swatch(tertiary, "Tertiary"), swatch(error, "Error"),
            ]},
            {t: "row", spacing: 10, c: [
                swatch(pri_container, "P. Cont"), swatch(sec_container, "S. Cont"),
                swatch(ter_container, "T. Cont"), swatch(surf_variant, "Surf Var"),
            ]},
        ]),
    ])
}

// Route the injected `screen` to the matching demo, defaulting to home.
fn body(s) {
    if s == "buttons" { return demo_buttons() }
    if s == "selection" { return demo_selection() }
    if s == "text" { return demo_text() }
    if s == "chips" { return demo_chips() }
    if s == "cards" { return demo_cards() }
    if s == "nav" { return demo_nav() }
    if s == "comms" { return demo_comms() }
    if s == "pickers" { return demo_pickers() }
    if s == "progress" { return demo_progress() }
    if s == "type" { return demo_type() }
    return home_screen()
}

// ---- root ------------------------------------------------------------------
// A hidden `nav_signal` Label the host reads for routing, plus the active
// screen (chosen by the injected `let screen = "..."`).

{t: "column", bg: page, pad: 16, c: [ body(st.route) ]}
